{
  "expo": {
    "name": "His voice",
    "slug": "his-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hisvoice",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/hisv.png",
        "backgroundColor": "#5e3c33"
      },
      "package": "com.boblambert.hisvoice",
      "edgeToEdgeEnabled": true
    },

    "web": {
      "favicon": "./assets/hisv.png"
    },
    "description": "Audio and transcribed versions of Prophet Lambert Lee sermons.",

    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1c1917",
          "image": "./assets/splashicon.png",
          "dark": {
            "image": "./assets/splashicon.png",
            "backgroundColor": "#1c1917"
          },
          "imageWidth": 300
        }
      ]
    ],

    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/8d5b01ec-32cb-4a05-b83f-83c918a5fa98"
    },

    "extra": {
      "eas": {
        "projectId": "8d5b01ec-32cb-4a05-b83f-83c918a5fa98"
      }
    },

    "owner": "josiah-ok",
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
