{
  "expo": {
    "name": "His voice",
    "slug": "his-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hisvoice",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boblambert.hisvoice",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2c221a"
      },
      "package": "com.boblambert.hisvoice",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/adaptive-icon.png"
    },
    "description": "Audio and transcribed versions of Prophet Lambert Lee sermons.",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2c221a",
          "image": "./assets/splashimg.png",
          "dark": {
            "image": "./assets/splashimg.png",
            "backgroundColor": "#2c221a"
          },
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-sqlite"
    ],
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/8d5b01ec-32cb-4a05-b83f-83c918a5fa98"
    },
    "extra": {
      "eas": {
        "projectId": "8d5b01ec-32cb-4a05-b83f-83c918a5fa98"
      }
    },
    "owner": "josiah-ok",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "cli": {
      "appVersionSource": "appJson"
    }
  }
}
